# ========= 培训题库系统 配置样例(复制为 .env 后按需修改) =========

# MySQL(仅 docker compose 使用)
MYSQL_ROOT_PASSWORD=root123456
MYSQL_DATABASE=question_bank
MYSQL_USER=tqb
MYSQL_PASSWORD=tqb123456
MYSQL_PORT=3307            # 宿主机映射端口(本机 3306 被占用时用 3307)

# 后端/前端端口
BACKEND_PORT=8080
WEB_PORT=8088

# ========= 百度千帆大模型出题配置(可选) =========
# 1. 打开 https://console.bce.baidu.com/qianfan/overview
# 2. 千帆控制台 -> 应用接入/API Key管理 -> 创建应用 -> 获取 API Key(形如 bce-v3/ALTAK-xxxx)
# 3. 模型名参考: ernie-4.0-turbo-8k / ernie-4.5-turbo-128k / ernie-speed-128k / deepseek-v3
# 4. 未配置时系统自动使用"本地模拟生成"演示模式, 出题流程不受影响
AI_PROVIDER=auto
QIANFAN_API_KEY=
QIANFAN_MODEL=ernie-4.0-turbo-8k

# JWT 密钥(生产环境务必修改, 长度>=32)
JWT_SECRET=TrainingQuestionBankSystem-Default-Jwt-Secret-2026-DevOnly
